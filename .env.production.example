# ========================================
# PodcastHub Production Environment Configuration
# ========================================
# This file contains production deployment settings
# Copy this to .env.production and update with your actual values

# ========================================
# DEPLOYMENT PLATFORM SETTINGS
# ========================================
ENVIRONMENT=production
DEBUG=False

# ========================================
# CLOUD DATABASE (Choose one)
# ========================================
# Option 1: Supabase PostgreSQL (Recommended - Free tier available)
# Get from: https://supabase.com/dashboard/project/_/settings/database
POSTGRES_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Option 2: Railway PostgreSQL
# POSTGRES_URL=postgresql+asyncpg://postgres:[password]@[host].railway.app:5432/railway

# Option 3: Neon PostgreSQL (Serverless)
# POSTGRES_URL=postgresql+asyncpg://[user]:[password]@[host].neon.tech/neondb

# ========================================
# CLOUD MESSAGE BROKER
# ========================================
# CloudAMQP (RabbitMQ as a Service)
# Get from: https://www.cloudamqp.com/
# Free tier: Little Lemur (1M messages/month)
RABBITMQ_URL=amqps://[username]:[password]@[server].cloudamqp.com/[vhost]

# Alternative: CloudKarafka
# RABBITMQ_URL=kafka://[username]:[password]@[server].cloudkarafka.com/[topic]

# ========================================
# CLOUD STORAGE
# ========================================
# Option 1: Cloudflare R2 (Recommended - S3 compatible, no egress fees)
# Get from: https://dash.cloudflare.com/
MINIO_ENDPOINT=[account-id].r2.cloudflarestorage.com
MINIO_ACCESS_KEY=[your-r2-access-key]
MINIO_SECRET_KEY=[your-r2-secret-key]
MINIO_SECURE=True
MINIO_BUCKET=podcast-recordings

# Option 2: AWS S3
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_ACCESS_KEY=[your-aws-access-key]
# MINIO_SECRET_KEY=[your-aws-secret-key]
# MINIO_SECURE=True
# MINIO_BUCKET=your-bucket-name

# Option 3: DigitalOcean Spaces
# MINIO_ENDPOINT=[region].digitaloceanspaces.com
# MINIO_ACCESS_KEY=[your-spaces-key]
# MINIO_SECRET_KEY=[your-spaces-secret]
# MINIO_SECURE=True
# MINIO_BUCKET=your-space-name

# ========================================
# CLOUD REDIS (Optional but recommended)
# ========================================
# Upstash Redis (Serverless)
# Get from: https://console.upstash.com/
REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

# Alternative: Redis Cloud
# REDIS_URL=redis://default:[password]@[endpoint].redislabs.com:12345

# ========================================
# CORS SETTINGS
# ========================================
# Add your actual frontend domain(s)
CORS_ORIGINS=["https://yourapp.vercel.app","https://www.yourapp.com","https://yourapp.com"]

# ========================================
# MEDIA PROCESSING
# ========================================
MEDIA_PROCESSING_QUEUE=media.processing.requests
MAX_CHUNK_SIZE=5242880  # 5MB
MAX_UPLOAD_SIZE=524288000  # 500MB
