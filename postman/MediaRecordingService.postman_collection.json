{
  "info": {
    "_postman_id": "f2c6cd3c-2c0c-4a0a-8a55-d9bc4e5fba01",
    "name": "PodcastHub - Media Recording Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for exercising the Media Recording Service (FastAPI) endpoints."
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"host_id\": \"host_123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/sessions/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sessions",
            "create"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Join Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"room_code\": \"ABC123\",\n  \"participant_id\": \"guest_001\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/sessions/join",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sessions",
            "join"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Start Recording",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"participant_id\": \"host_123\",\n  \"track_type\": \"audio\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/recordings/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "recordings",
            "start"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Upload Chunk",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "multipart/form-data"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "recording_id",
              "value": "{{recordingId}}",
              "type": "text"
            },
            {
              "key": "sequence",
              "value": "1",
              "type": "text"
            },
            {
              "key": "checksum",
              "value": "d41d8cd98f00b204e9800998ecf8427e",
              "type": "text"
            },
            {
              "key": "chunk_file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/uploads/chunk",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "uploads",
            "chunk"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Enqueue Processing",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/uploads/recording/{{recordingId}}/enqueue-processing",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "uploads",
            "recording",
            "{{recordingId}}",
            "enqueue-processing"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Recording Upload Progress",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/uploads/recording/{{recordingId}}/progress",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "uploads",
            "recording",
            "{{recordingId}}",
            "progress"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001"
    },
    {
      "key": "sessionId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "recordingId",
      "value": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
