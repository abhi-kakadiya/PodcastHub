# PodcastHub Frontend Environment Configuration

# ========================================
# LOCAL DEVELOPMENT
# ========================================
# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8001/api

# WebSocket URL for WebRTC signaling
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws

# ========================================
# PRODUCTION DEPLOYMENT
# ========================================
# Uncomment and update these for production:
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api
# NEXT_PUBLIC_WS_URL=wss://your-backend.railway.app/ws

# ========================================
# App Configuration
# ========================================
NEXT_PUBLIC_APP_NAME=PodcastHub
NEXT_PUBLIC_APP_DESCRIPTION=Professional Podcast Recording Platform

# ========================================
# TURN Server Configuration (REQUIRED for Public P2P)
# ========================================
# TURN servers enable P2P connections through NAT/firewalls
# Without TURN, ~20% of users won't be able to connect
#
# Free TURN Server Options:
# 1. Metered.ca - https://www.metered.ca/tools/openrelay/ (Free tier available)
# 2. Xirsys - https://xirsys.com/ (Free tier: 500MB/month)
# 3. Twilio STUN/TURN - https://www.twilio.com/stun-turn (Pay as you go)
#
# Example configuration:
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=your-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-credential
#
# Or multiple TURN servers (comma-separated):
# NEXT_PUBLIC_TURN_URL=turn:turn1.example.com:3478,turn:turn2.example.com:3478

NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
