# Application Settings
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8001

# RabbitMQ Settings
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=podcast_events

# CORS Settings
# For local development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]
# For public deployment, add your domain(s):
# CORS_ORIGINS=["https://yourapp.com","https://www.yourapp.com","https://yourapp.vercel.app"]
# Or use wildcard for development/testing only (NOT recommended for production):
# CORS_ORIGINS=["*"]

# Upload Settings
MAX_CHUNK_SIZE=5242880  # 5MB in bytes
MAX_UPLOAD_SIZE=524288000  # 500MB in bytes

# Media Processing
MEDIA_PROCESSING_QUEUE=media.processing.requests

# PostgreSQL Settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=podcasthub
POSTGRES_PASSWORD=podcasthub123
POSTGRES_DATABASE=podcasthub
